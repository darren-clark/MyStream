{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ToyStream": {
    "Host": "localhost",
    "Port": 5000,
    "Consumer": {
      "Topics": [ "events" ],
      "StartAt": "Earliest",
      "MaxWaitMilliseconds": 5000
    },
    "Producer": {
      "Topic": "events",
      "Partition": 0
    },
    "Subscriber": {
      "Topic": "events",
      "StartAt": "Earliest"
    }
  }
}
